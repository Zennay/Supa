[Unit]
Description=SUPA approved fresh supermarket prices localhost search service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=supa
WorkingDirectory=/opt/supa
EnvironmentFile=/etc/supa/scraper.env
ExecStart=/usr/bin/node /opt/supa/scraper/retailer-search-api.mjs
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
